fluents:
    taken_cannolo.
    fried_cannolo.
    stuffed_cannolo.


actions:
    take_cannolo.
    discard_cannolo.
    fry_cannolo.
    stuff_cannolo.

always:

    executable take_cannolo.
	caused taken_cannolo after take_cannolo.

    executable discard_cannolo if taken_cannolo.
	caused -taken_cannolo after discard_cannolo.

    executable fry_cannolo if taken_cannolo.
	caused fried_cannolo after fry_cannolo.

    executable stuff_cannolo if fried_cannolo.
	caused stuffed_cannolo after stuff_cannolo.
    caused -fried_cannolo after stuff_cannolo.

    
	inertial taken_cannolo.
	inertial fried_cannolo.
	inertial stuffed_cannolo.


noConcurrency.
	

goal:
	stuffed_cannolo?
