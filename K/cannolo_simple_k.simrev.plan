actions:
take_cannolo.
discard_cannolo.
fry_cannolo.
stuff_cannolo.
sep.

always:
executable take_cannolo.
caused taken_cannolo after take_cannolo, not sep.
executable discard_cannolo if taken_cannolo.
caused -taken_cannolo after discard_cannolo, not sep.
executable fry_cannolo if taken_cannolo.
caused fried_cannolo after fry_cannolo, not sep.
executable stuff_cannolo if fried_cannolo.
caused stuffed_cannolo after stuff_cannolo, not sep.
caused -fried_cannolo after stuff_cannolo, not sep.
inertial taken_cannolo.
inertial fried_cannolo.
inertial stuffed_cannolo.
noConcurrency.
nonexecutable take_cannolo if sep.
nonexecutable discard_cannolo if sep.
nonexecutable fry_cannolo if sep.
nonexecutable stuff_cannolo if sep.
executable sep if -sep_occ.
caused bar_taken_cannolo after bar_taken_cannolo.
caused -bar_taken_cannolo after -bar_taken_cannolo.
caused taken_cannolo after taken_cannolo, sep.
caused -taken_cannolo after -taken_cannolo, sep.
caused -goal_cond if taken_cannolo, -bar_taken_cannolo.
caused -goal_cond if -taken_cannolo, bar_taken_cannolo.
caused bar_fried_cannolo after bar_fried_cannolo.
caused -bar_fried_cannolo after -bar_fried_cannolo.
caused fried_cannolo after fried_cannolo, sep.
caused -fried_cannolo after -fried_cannolo, sep.
caused -goal_cond if fried_cannolo, -bar_fried_cannolo.
caused -goal_cond if -fried_cannolo, bar_fried_cannolo.
caused bar_stuffed_cannolo after bar_stuffed_cannolo.
caused -bar_stuffed_cannolo after -bar_stuffed_cannolo.
caused stuffed_cannolo after stuffed_cannolo, sep.
caused -stuffed_cannolo after -stuffed_cannolo, sep.
caused -goal_cond if stuffed_cannolo, -bar_stuffed_cannolo.
caused -goal_cond if -stuffed_cannolo, bar_stuffed_cannolo.
caused sep_occ after sep.
caused sep_occ after sep_occ.
caused -sep_occ after -sep_occ, not sep.
caused -goal_cond if -sep_occ.
caused goal_cond if not -goal_cond.

initially:
-sep_occ.
caused bar_taken_cannolo if taken_cannolo.
caused -bar_taken_cannolo if -taken_cannolo.
total taken_cannolo.
caused bar_fried_cannolo if fried_cannolo.
caused -bar_fried_cannolo if -fried_cannolo.
total fried_cannolo.
caused bar_stuffed_cannolo if stuffed_cannolo.
caused -bar_stuffed_cannolo if -stuffed_cannolo.
total stuffed_cannolo.
caused start_cond if bar_taken_cannolo.
caused false if not start_cond.

goal:
goal_cond?
